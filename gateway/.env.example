# Gateway mode: demo never sends external messages or publishes content.
GATEWAY_MODE=demo
GATEWAY_PORT=8787
GATEWAY_ADMIN_TOKEN=replace-with-long-random-token

# Live publishing requires BOTH the provider variables and this explicit flag.
ALLOW_LIVE_PUBLISH=false

# Instagram Graph API / Business account
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok for Business API
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Respond.io channel / WhatsApp provider
RESPOND_IO_TOKEN=
RESPOND_IO_SPACE_ID=
RESPOND_IO_CHANNEL_ID=
RESPOND_IO_BASE_URL=https://api.respond.io
